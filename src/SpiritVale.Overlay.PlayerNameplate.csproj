<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpiritVale.Overlay.PlayerNameplate</RootNamespace>
    <AssemblyName>SpiritVale.Overlay.PlayerNameplate</AssemblyName>
    <Version>1.4.2</Version>
    <OverlayRoot Condition="'$(OverlayRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\SpiritVale-Overlay'))</OverlayRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(OverlayRoot)\src\SpiritVale.Overlay.Api\SpiritVale.Overlay.Api.csproj">
      <Private>false</Private>
    </ProjectReference>
    <EmbeddedResource Include="status-catalog.json" LogicalName="SpiritVale.Overlay.PlayerNameplate.status-catalog.json" />
  </ItemGroup>

  <Target Name="CopyToOverlayPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_Dll>$(TargetPath)</_Dll>
      <_HostPlugins>$(OverlayRoot)\src\SpiritVale.Overlay.Host\bin\$(Configuration)\net8.0-windows\Plugins\SpiritVale.Overlay.PlayerNameplate</_HostPlugins>
      <_AppDataPlugins>$(APPDATA)\SpiritValeOverlay\plugins\SpiritVale.Overlay.PlayerNameplate</_AppDataPlugins>
    </PropertyGroup>
    <MakeDir Directories="$(_HostPlugins)" Condition="Exists('$(_Dll)')" />
    <Copy SourceFiles="$(_Dll)" DestinationFolder="$(_HostPlugins)" SkipUnchangedFiles="true" Condition="Exists('$(_Dll)')" />
    <!-- Do not copy into dist/win-x64/Plugins — manager ships without bundled plugins. -->
    <MakeDir Directories="$(_AppDataPlugins)" Condition="Exists('$(_Dll)')" />
    <Copy SourceFiles="$(_Dll)" DestinationFolder="$(_AppDataPlugins)" SkipUnchangedFiles="true" Condition="Exists('$(_Dll)')" ContinueOnError="true" />
  </Target>

</Project>
